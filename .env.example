# Copy to .env and fill in. Never commit .env.
# openai | gemini | anthropic | mock (offline demo, no key needed)
LLM_PROVIDER=openai
# Optional model override (defaults: gpt-4o-mini / gemini-2.5-flash / claude-haiku-5-5)
LLM_MODEL=

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Max reviews per upload (caps cost per run)
MAX_REVIEWS=500

# --- Weekly email (stretch goal) ---
# Gmail: smtp.gmail.com, port 587, SMTP_USER = your Gmail, SMTP_PASSWORD = a Google *App Password*
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated list of people who get the report
REPORT_RECIPIENTS=
REPORT_DAY=monday
REPORT_TIME=09:00
REPORT_TIMEZONE=Asia/Kolkata
# Link included in the email
APP_URL=https://www.kowsalyagroups.com/techstack/

# --- Server / production only (docker-compose.prod.yml) ---
# Domain that points at the server (DNS A record), and the sub-path of the app
APP_DOMAIN=www.example.com
APP_PATH=techstack
# Optional login password for the web app (leave empty = public)
APP_PASSWORD=
