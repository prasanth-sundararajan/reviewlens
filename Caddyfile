# HTTPS reverse proxy for production. Caddy fetches and renews Let's Encrypt certificates itself.
# APP_DOMAIN may be a comma-separated list, e.g. "www.example.com, techstack.example.com".
# The app is served under /{$APP_PATH}/ ; any other path redirects there.
{$APP_DOMAIN} {
	encode gzip
	redir /{$APP_PATH} /{$APP_PATH}/ 308
	@app path /{$APP_PATH}/*
	handle @app {
		reverse_proxy reviewlens:8501
	}
	handle {
		redir * /{$APP_PATH}/ 302
	}
}
