# HTTPS reverse proxy for production. Caddy fetches and renews Let's Encrypt certificates itself.
# APP_DOMAIN may be a comma-separated list, e.g. "www.example.com, techstack.example.com".
# The app is served under /{$APP_PATH}/ ; any other path redirects there.
{$APP_DOMAIN} {
	encode gzip
	# Other apps on the same server (e.g. LaunchScout at /techstack/launchscout/) drop their
	# own route files into ./sites.d/*.caddy. They are imported before ReviewLens' route, so
	# their paths win; with no files there this line does nothing.
	import /etc/caddy/sites.d/*.caddy
	redir /{$APP_PATH} /{$APP_PATH}/ 308
	@app path /{$APP_PATH}/*
	handle @app {
		# Caddy matches paths case-insensitively but Streamlit does not: send other
		# spellings (e.g. /techstack/reviewlens/) to the exact path.
		@app_other_case not path_regexp ^/{$APP_PATH}/
		redir @app_other_case /{$APP_PATH}/ 302
		reverse_proxy reviewlens:8501
	}
	handle {
		redir * /{$APP_PATH}/ 302
	}
}

# Bare domain: redirect to www (added for SlotEase/portfolio security)
kowsalyagroups.com {
	redir https://www.kowsalyagroups.com{uri} 308
}
